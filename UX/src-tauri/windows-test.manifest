<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Chỉ dùng cho file test trên Windows: tauri/wry gọi TaskDialogIndirect (comctl32 v6); không có manifest này tiến trình chết lúc khởi động
       với 0xc0000139 STATUS_ENTRYPOINT_NOT_FOUND. Bản app thật đã có manifest do tauri-build nhúng. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
</assembly>
