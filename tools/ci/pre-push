#!/usr/bin/env bash
# Hook pre-push: chỉ cho push dev/mvp và main khi commit đã xanh trên CI máy (tools/ci/local_ci.sh).
# Commit merge vào main được chấp nhận nếu cây (tree) của nó trùng cây của một commit đã xanh.
# Bỏ qua có chủ đích: FONTATLAS_CI_SKIP=1 git push ...   (sẽ in cảnh báo)
set -uo pipefail
ZERO=0000000000000000000000000000000000000000

note_ok() { # note_ok <sha> → 0 nếu note CI dòng đầu là pass và có QA
  local first; first="$(git notes --ref=ci show "$1" 2>/dev/null | head -n1)"
  [[ "$first" == pass* && "$first" == *qa=1* ]]
}
green() {
  local sha="$1" tree p
  note_ok "$sha" && return 0
  tree="$(git rev-parse "$sha^{tree}")"
  for p in $(git rev-list --parents -n1 "$sha" | cut -d' ' -f2-); do
    [ "$(git rev-parse "$p^{tree}")" = "$tree" ] && note_ok "$p" && return 0
  done
  return 1
}

bad=0
while read -r lref lsha rref rsha; do
  case "$rref" in refs/heads/dev/mvp|refs/heads/main) ;; *) continue ;; esac
  [ "$lsha" = "$ZERO" ] && continue  # xoá nhánh: không phải việc của CI
  if green "$lsha"; then
    echo "local CI: ${rref#refs/heads/} ${lsha:0:9} xanh ✓"
  elif [ "${FONTATLAS_CI_SKIP:-}" = 1 ]; then
    echo "local CI: CẢNH BÁO — push ${rref#refs/heads/} ${lsha:0:9} khi chưa xanh (FONTATLAS_CI_SKIP=1)"
  else
    echo "local CI: ${rref#refs/heads/} ${lsha:0:9} chưa có kết quả xanh (kèm QA native)."
    echo "  chạy: bash tools/ci/local_ci.sh ${lsha:0:9}"
    bad=1
  fi
done
exit $bad
